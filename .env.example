# 复制为 .env 后填写真实密钥；不要提交 .env。
SUNO_API_KEY=
DASHSCOPE_API_KEY=

# 本地服务监听端口。
PORT=3000

# 可被外部服务访问的回调基础地址；仅本地开发需要填写公网隧道地址。
# Render 部署会无条件优先使用平台提供的 RENDER_EXTERNAL_URL，
# 即使 PUBLIC_BASE_URL 或页面 callbackUrl 仍是旧 ngrok 地址也不会采用。
PUBLIC_BASE_URL=http://localhost:3000

# 分享密码解锁凭证的签名密钥，至少 32 个字符；生产环境请使用随机值并妥善保管。
SHARE_SESSION_SECRET=

# Render Persistent Disk 挂载目录；本地开发保持注释即可。
# 设置后分享数据写入 STORAGE_DIR/data，上传音频写入 STORAGE_DIR/uploads。
# STORAGE_DIR=/opt/render/project/src/storage

# 可选：覆盖内置分享图片目录，主要用于自动化测试或自定义部署。
# SHARE_IMAGES_DIR=/absolute/path/to/share-images
